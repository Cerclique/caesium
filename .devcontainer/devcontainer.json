// Dev container for VS Code and GitHub Codespaces; see docs/CONTRIBUTING.md.
{
  "name": "lithium",
  // Debian trixie with the stable Rust toolchain, rustfmt, clippy and rust-analyzer.
  "image": "mcr.microsoft.com/devcontainers/rust:2-1-trixie",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["tamasfe.even-better-toml", "EditorConfig.EditorConfig"],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
